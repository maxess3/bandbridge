model Band {
    id                String         @id @default(uuid())
    profilePictureKey String?
    name              String         @unique
    genres            MusicGenre[]
    description       String?        @db.Text
    country           String?        @db.VarChar(60)
    city              String?        @db.VarChar(60)
    zipCode           String?        @db.VarChar(10)
    departmentName    String?        @db.VarChar(60)
    bandMembers       BandMember[]
    hiringAds         BandHiringAd[]
    createdAt         DateTime       @default(now())
    updatedAt         DateTime       @updatedAt
}

model BandMember {
    id        String         @id @default(uuid())
    bandId    String
    profileId String
    role      BandMemberRole @default(MEMBER)
    band      Band           @relation(fields: [bandId], references: [id], onDelete: Cascade)
    profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

    @@unique([bandId, profileId])
}

model BandHiringAd {
    id                String             @id @default(uuid())
    title             String             @db.VarChar(255)
    content           String             @db.Text
    rehearsalsPerWeek RehearsalFrequency?
    country           String?            @db.VarChar(60)
    city              String?            @db.VarChar(60)
    zipCode           String?            @db.VarChar(10)
    departmentName    String?            @db.VarChar(60)
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
    bandId            String
    band              Band               @relation(fields: [bandId], references: [id], onDelete: Cascade)
    requiredSlots     BandRequiredSlot[]

    @@unique([bandId, title])
}

model BandRequiredSlot {
    id         String         @id @default(uuid())
    quantity   Int            @default(1)
    hiringAdId String
    roleId     String
    hiringAd   BandHiringAd   @relation(fields: [hiringAdId], references: [id], onDelete: Cascade)
    role       Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([hiringAdId, roleId])
}
